#!/bin/bash
# fake-codex - 테스트 전용 가짜 codex. 실제 codex 는 절대 부르지 않는다.
#
# 받는 인자 (cc_codex_argv 와 같은 두 형태)
#   exec --json -s workspace-write --output-schema <schema> -o <result> -
#   exec resume --json -c sandbox_mode="workspace-write" --output-schema <schema> -o <result> <session_id> -
#
# 기록 (n = 이 테스트에서 몇 번째 호출인지, mkdir 로 겹치지 않게 센다)
#   $FAKE_CODEX_LOG/<n>.argv   인자 한 줄에 하나
#   $FAKE_CODEX_LOG/<n>.stdin  받은 stdin 그대로
#   $FAKE_CODEX_LOG/<n>.cwd    실행 위치
#
# 환경변수
#   FAKE_CODEX_SEQ     쉼표로 구분한 호출 순서별 모드 (예: fail_fast,ok). 목록이 끝나면 ok
#   FAKE_CODEX_RESULT  ok 일 때 -o 파일에 쓸 JSON (기본: 유효한 plan 응답)
#   FAKE_CODEX_DELAY   slow·fail_slow 모드에서 기다릴 초 (기본 3)
#   FAKE_CODEX_LOGIN   hang 이면 30초 동안 응답하지 않음(시간 제한 시험). fail 이면 `login status` 가 로그인 안 됨(exit 1). 그 밖에는 로그인됨(exit 0)
#
# 모드
#   ok            exec 이면 thread.started(thread_id fake-thread-1), turn.completed(usage 100/20/10), 결과 기록, exit 0
#   invalid_json  이벤트는 ok 와 같고 -o 에 "not json" 기록, exit 0
#   invalid_json_no_thread  invalid_json 과 같지만 thread.started 를 쓰지 않음 (세션 ID 를 알 수 없음)
#   fail_fast     stderr 에 오류 한 줄, exit 1
#   fail_slow     FAKE_CODEX_DELAY 초 기다린 뒤 fail_fast 와 같음
#   fail_with_output  -o 에 "not json" 을 쓰고 stderr 에 오류 한 줄, exit 1
#   hang          명령줄에 테스트 폴더 표시가 있는 자식(sleep 1000)을 만들고 자신도 계속 대기
#   hang_stubborn hang 과 같지만 자신과 자식 모두 TERM 을 무시 (KILL 로만 끝남)
#   ok_leave_child  같은 그룹에 자식(sleep 1000)을 남겨 두고 ok 로 끝남. 자식 PID 는 <n>.leftover
#   slow          FAKE_CODEX_DELAY 초 동안 1초마다 이벤트를 쓰다가 ok
#   slow_invalid_json  slow 와 같지만 끝에 -o 에 "not json" 기록 (invalid_json 처럼)
#   ok_unusable   스키마에는 맞지만 절차가 쓸 수 없는 결과 (verdict plan, 마일스톤 없음, 지시 null) 를 쓰고 exit 0
#
# 앞에 붙이는 동작 (R31/R32 수정 감시 시험): 모드가 "<동작>:<모드>" 이면 실행 위치(저장소 루트)에서 그 동작을 한 뒤
#   <모드> 로 계속한다 (예: edit_tracked:ok, edit_tracked:hang, new_file:ok). 동작 여러 개는 + 로 잇는다
#   (예: slowsnap+edit_tracked:hang. 모드는 마지막 : 뒤에 하나)
#   edit_tracked  추적 중인 base.txt 끝에 "codex edit" 한 줄을 더한다
#   new_file      추적되지도 무시되지도 않는 새 파일 "새 파일.txt" 를 만든다
#   ignored_only  git 이 무시하는 파일만 쓴다: codex-cache/out.log (테스트가 .gitignore 에 codex-cache/ 를 넣어 둔다)
#   many_files    추적되지 않는 새 파일 12개 (many/f01.txt … many/f12.txt)
#   snapfail      저장소는 건드리지 않고 $FAKE_CODEX_LOG/snapfail 표시만 만든다 (테스트의 가짜 git 이 이 표시를 보고
#                 그 뒤의 작업 트리 스냅샷을 실패시킨다)
#   slowsnap      저장소는 건드리지 않고 $FAKE_CODEX_LOG/slowsnap 표시만 만든다 (테스트의 가짜 git 이 이 표시를 보고
#                 그 뒤의 작업 트리 스냅샷을 오래 걸리게 한다)
#   edit_submodule  하위 모듈 sub 안의 추적 파일 sub/s.txt 끝에 "codex edit" 한 줄을 더한다
#   late_edit     같은 프로세스 그룹에 자식을 남긴다: FAKE_CODEX_LATE_SECS(기본 3)초 뒤 base.txt 끝에 "late edit" 를 더하고 끝남
#                 (명령줄 표시 fake-codex-late:<log>, 자식 PID 는 <n>.late)
#   late_remove_new  late_edit 과 같지만 그 자식이 base.txt 대신 "새 파일.txt" 를 지운다 (new_file 과 함께 써서 최종 트리를 실행 전과 같게)
#   (R33 보안 시험) 아래 "악성" 설정은 git 이 실행하면 $FAKE_CODEX_LOG/marker.fsmonitor·marker.filter 를 만드는 스크립트를 가리킨다.
#   이 표시가 생기면 /cc 가 Codex 가 만든 설정으로 git 을 실행한 것이다 (sandbox 밖에서 명령 실행)
#   nested_evil   커밋이 하나 있는 새 중첩 저장소 evil/ 을 만들고, 그 .git/config 에 core.fsmonitor·filter.evil.clean 과
#                 evil/.gitattributes(* filter=evil), 고친 evil/e.txt 를 둔다
#   nested_evil_empty  nested_evil 과 같지만 커밋이 없는 중첩 저장소
#   gitcfg_evil   최상위 .git/config 에 core.fsmonitor·filter.evil.clean 을 넣고 .gitattributes(* filter=evil) 를 만든다
#   gitcfg_include  cc-local.gitconfig (테스트가 .git/config 의 include.path 로 미리 가리켜 둔 파일) 에 같은 악성 설정을 쓰고
#                 .gitattributes(* filter=evil) 를 만든다
#   (R34 무시된 파일 감시 시험. 테스트가 .gitignore 에 .env, node_modules/, dist/, .cache/ 를 넣어 둔다)
#   edit_env      .env 끝에 한 줄을 더한다
#   edit_node_module  node_modules/pkg/index.js 끝에 한 줄을 더한다
#   new_node_module_file  node_modules/pkg/new.js 를 만든다
#   ignored_build_cache   dist/app.js 와 .cache/c.txt 를 쓴다 (감시 대상이 아닌 무시된 출력)
#   node_module_tool_caches  node_modules/.cache/babel/c.json 과 node_modules/.vite/deps/d.js 를 쓴다 (감시에서 뺀 도구 캐시)
#   (Codex 보안 검수 1차) mark_ran  $FAKE_CODEX_LOG/codex.ran 표시만 만든다 (테스트의 가짜 git 이 그 뒤의 git 호출만 기록하도록)
#   submodule_redirect_evil  .git/modules/sub/evil 에 악성 설정을 가진 새 git 디렉터리를 만들고 sub/.git 을 그쪽으로 바꾼 뒤
#                 sub/.gitattributes(* filter=evil) 와 고친 sub/s.txt 를 둔다
#   edit_submodule_env  하위 모듈 sub 의 git 이 무시하는 sub/.env 끝에 한 줄을 더한다
#   gitcfg_evil_info  gitcfg_evil 과 같지만 filter 속성을 작업 트리가 아니라 .git/info/attributes 에 둔다 (작업 트리는 깨끗한 채로)
#   (Codex 보안 검수 2차) gitdir_swap_gitfile  진짜 .git 을 $FAKE_CODEX_LOG/realgit 으로 옮기고, 같은 커밋·인덱스를 가진 악성 gitdir
#                 $FAKE_CODEX_LOG/evilgit (filter·fsmonitor, info/attributes 의 * filter=evil) 을 만든 뒤 .git 을 그쪽을 가리키는 gitfile 로
#   gitdir_swap_symlink  gitdir_swap_gitfile 과 같지만 .git 을 evilgit 을 가리키는 심볼릭 링크로
#   qwrite_fail   격리 기록을 쓰지 못하게 한다 (실패 시험: $CLAUDE_PLUGIN_DATA/cc/quarantine 과 .git/yultopia-cc 를 쓰기 금지로)

log="${FAKE_CODEX_LOG:-${TMP:-/tmp}/fake-codex.log}"
mkdir -p "$log" || exit 70
# `codex login status` (preflight 의 로그인 확인): 호출 번호를 쓰지 않는다 (FAKE_CODEX_SEQ 순서에 끼지 않도록).
#   부를 때마다 인자를 $log/login.calls 에 한 줄로 남긴다. FAKE_CODEX_LOGIN=fail 이면 로그인 안 됨(exit 1)
if [ "${1:-}" = login ]; then
  printf '%s\n' "$*" >> "$log/login.calls"
  [ "${FAKE_CODEX_LOGIN:-ok}" = hang ] && sleep 30   # 시간 제한 시험: 오래 걸리는 login status
  if [ "${2:-}" = status ] && [ "${FAKE_CODEX_LOGIN:-ok}" != fail ]; then
    echo "Logged in using ChatGPT (fake)"
    exit 0
  fi
  echo "Not logged in (fake)" >&2
  exit 1
fi
n=1
while ! mkdir "$log/.n.$n" 2>/dev/null; do
  n=$((n + 1))
  [ "$n" -gt 1000 ] && { echo "fake-codex: 호출 번호를 정하지 못했습니다" >&2; exit 71; }
done
printf '%s\n' "$@" > "$log/$n.argv"
cat > "$log/$n.stdin"
pwd -P > "$log/$n.cwd"

resume=0
[ "${1:-}" = exec ] && [ "${2:-}" = resume ] && resume=1
out=""
while [ $# -gt 0 ]; do
  case "$1" in
    -o) out="${2:-}"; [ $# -gt 1 ] && shift ;;
  esac
  shift
done

# 악성 설정이 가리킬 스크립트: 실행되면 표시 파일을 만든다
evil_scripts() {
  printf '#!/bin/sh\n: > "%s/marker.fsmonitor"\nexit 1\n' "$log" > "$log/evil-fsmonitor.sh"
  printf '#!/bin/sh\n: > "%s/marker.filter"\ncat\n' "$log" > "$log/evil-clean.sh"
  chmod +x "$log/evil-fsmonitor.sh" "$log/evil-clean.sh"
}
evil_config() {   # <config 파일>
  git config -f "$1" core.fsmonitor "$log/evil-fsmonitor.sh" && git config -f "$1" filter.evil.clean "$log/evil-clean.sh"
}
# evil_gitdir : 진짜 .git 을 $log/realgit 으로 옮기고 같은 커밋·인덱스의 악성 gitdir $log/evilgit 을 만든다
evil_gitdir() {
  evil_scripts
  mv .git "$log/realgit" || exit 3
  git clone -q --bare "$log/realgit" "$log/evilgit" >/dev/null 2>&1 || exit 3
  git config -f "$log/evilgit/config" core.bare false
  git config -f "$log/evilgit/config" core.worktree "$(pwd -P)"
  git --git-dir="$log/evilgit" --work-tree="$(pwd -P)" read-tree HEAD || exit 3
  mkdir -p "$log/evilgit/info" && printf '* filter=evil\n' > "$log/evilgit/info/attributes"
  evil_config "$log/evilgit/config" || exit 3
}
nested_evil() {   # <1 커밋 만듦 | 0 커밋 없음>
  evil_scripts
  git init -q evil || exit 3
  printf 'e\n' > evil/e.txt
  if [ "$1" = 1 ]; then
    ( cd evil && git add e.txt && git -c user.name=c -c user.email=c@example.com -c commit.gpgsign=false commit -q -m e ) || exit 3
    printf 'changed\n' >> evil/e.txt
  fi
  printf '* filter=evil\n' > evil/.gitattributes
  evil_config evil/.git/config || exit 3
}

IFS=, read -r -a seq <<< "${FAKE_CODEX_SEQ:-}"
mode="${seq[$((n - 1))]:-ok}"

case "$mode" in
  *:*)
    actions="${mode%:*}"; mode="${mode##*:}"
    IFS=+ read -r -a acts <<< "$actions"
    for action in "${acts[@]}"; do
    case "$action" in
      edit_tracked) printf 'codex edit\n' >> base.txt ;;
      new_file) printf 'codex\n' > "새 파일.txt" ;;
      ignored_only) mkdir -p codex-cache && printf 'cache\n' > codex-cache/out.log ;;
      many_files)
        mkdir -p many
        for i in 01 02 03 04 05 06 07 08 09 10 11 12; do printf '%s\n' "$i" > "many/f$i.txt"; done ;;
      snapfail) : > "$log/snapfail" ;;
      slowsnap) : > "$log/slowsnap" ;;
      edit_submodule) printf 'codex edit\n' >> sub/s.txt ;;
      late_edit)
        perl -e 'sleep $ARGV[0]; open(my $f, ">>", "base.txt") or exit 1; print $f "late edit\n"' \
          "${FAKE_CODEX_LATE_SECS:-3}" "fake-codex-late:$log" > /dev/null 2>&1 < /dev/null &
        printf '%s\n' "$!" > "$log/$n.late" ;;
      late_remove_new)
        perl -e 'sleep $ARGV[0]; unlink "새 파일.txt"' \
          "${FAKE_CODEX_LATE_SECS:-3}" "fake-codex-late:$log" > /dev/null 2>&1 < /dev/null &
        printf '%s\n' "$!" > "$log/$n.late" ;;
      nested_evil) nested_evil 1 ;;
      nested_evil_empty) nested_evil 0 ;;
      gitcfg_evil)
        evil_scripts
        printf '* filter=evil\n' > .gitattributes
        evil_config .git/config || exit 3 ;;
      gitcfg_include)
        evil_scripts
        printf '* filter=evil\n' > .gitattributes
        evil_config cc-local.gitconfig || exit 3 ;;
      edit_env) printf 'CODEX=1\n' >> .env ;;
      edit_node_module) printf '// codex\n' >> node_modules/pkg/index.js ;;
      new_node_module_file) printf 'codex\n' > node_modules/pkg/new.js ;;
      ignored_build_cache) mkdir -p dist .cache && printf 'build\n' > dist/app.js && printf 'cache\n' > .cache/c.txt ;;
      mark_ran) : > "$log/codex.ran" ;;
      gitdir_swap_gitfile) evil_gitdir; printf 'gitdir: %s\n' "$log/evilgit" > .git ;;
      gitdir_swap_symlink) evil_gitdir; ln -s "$log/evilgit" .git ;;
      qwrite_fail)
        mkdir -p "$CLAUDE_PLUGIN_DATA/cc/quarantine" && chmod 555 "$CLAUDE_PLUGIN_DATA/cc/quarantine"
        chmod 555 .git/yultopia-cc ;;
      submodule_redirect_evil)
        evil_scripts
        git init -q --bare .git/modules/sub/evil || exit 3
        git config -f .git/modules/sub/evil/config core.bare false
        git config -f .git/modules/sub/evil/config core.worktree "$(pwd -P)/sub"
        evil_config .git/modules/sub/evil/config || exit 3
        printf 'gitdir: ../.git/modules/sub/evil\n' > sub/.git
        printf '* filter=evil\n' > sub/.gitattributes
        printf 'codex edit\n' >> sub/s.txt ;;
      edit_submodule_env) printf 'CODEX=1\n' >> sub/.env ;;
      gitcfg_evil_info)
        evil_scripts
        mkdir -p .git/info && printf '* filter=evil\n' > .git/info/attributes
        evil_config .git/config || exit 3 ;;
      node_module_tool_caches)
        mkdir -p node_modules/.cache/babel node_modules/.vite/deps \
          && printf '{}\n' > node_modules/.cache/babel/c.json && printf 'export {}\n' > node_modules/.vite/deps/d.js ;;
      *) echo "fake-codex: 알 수 없는 동작: $action" >&2; exit 2 ;;
    esac
    done ;;
esac

default_result='{"verdict":"plan","summary":"가짜 계획","plan":{"overview":"가짜 전체 계획","milestones":[{"id":1,"title":"첫 단계","done_criteria":"테스트 통과"},{"id":2,"title":"둘째 단계","done_criteria":"검수 통과"}]},"milestone":1,"instruction":"1번 마일스톤을 구현하세요","findings":[],"question":null}'

thread_started() {
  [ "$resume" = 0 ] && printf '%s\n' '{"type":"thread.started","thread_id":"fake-thread-1"}'
  printf '%s\n' '{"type":"turn.started"}'
}
turn_completed() {
  printf '%s\n' '{"type":"turn.completed","usage":{"input_tokens":100,"cached_input_tokens":20,"output_tokens":10}}'
}
write_out() {
  [ -n "$out" ] || return 0
  printf '%s\n' "$1" > "$out"
}

case "$mode" in
  ok)
    thread_started; turn_completed
    write_out "${FAKE_CODEX_RESULT:-$default_result}"
    exit 0 ;;
  invalid_json)
    thread_started; turn_completed
    write_out "not json"
    exit 0 ;;
  ok_unusable)
    thread_started; turn_completed
    write_out '{"verdict":"plan","summary":"빈 계획","plan":{"overview":"o","milestones":[]},"milestone":null,"instruction":null,"findings":[],"question":null}'
    exit 0 ;;
  invalid_json_no_thread)
    printf '%s\n' '{"type":"turn.started"}'; turn_completed
    write_out "not json"
    exit 0 ;;
  fail_fast)
    echo "fake-codex: 가짜 실행 오류" >&2
    exit 1 ;;
  fail_slow)
    sleep "${FAKE_CODEX_DELAY:-3}"
    echo "fake-codex: 가짜 실행 오류(늦음)" >&2
    exit 1 ;;
  fail_with_output)
    write_out "not json"
    echo "fake-codex: 결과를 쓰고 실패" >&2
    exit 1 ;;
  hang)
    thread_started
    perl -e 'sleep 1000' "fake-codex-hang:$log" &
    wait
    exit 0 ;;
  hang_stubborn)
    trap '' TERM
    thread_started
    perl -e '$SIG{TERM} = "IGNORE"; sleep 1000' "fake-codex-stubborn:$log" &
    while :; do wait; sleep 0.2; done ;;
  ok_leave_child)
    perl -e 'sleep 1000' "fake-codex-leftover:$log" > /dev/null 2>&1 < /dev/null &
    printf '%s\n' "$!" > "$log/$n.leftover"
    thread_started; turn_completed
    write_out "${FAKE_CODEX_RESULT:-$default_result}"
    exit 0 ;;
  slow|slow_invalid_json)
    thread_started
    i=0
    while [ "$i" -lt "${FAKE_CODEX_DELAY:-3}" ]; do
      sleep 1
      printf '%s\n' '{"type":"item.completed","item":{"type":"reasoning"}}'
      i=$((i + 1))
    done
    turn_completed
    if [ "$mode" = slow ]; then write_out "${FAKE_CODEX_RESULT:-$default_result}"; else write_out "not json"; fi
    exit 0 ;;
  *)
    echo "fake-codex: 알 수 없는 모드: $mode" >&2
    exit 2 ;;
esac
